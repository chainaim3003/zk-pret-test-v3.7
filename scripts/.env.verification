# ─── Transaction Verifier Configuration ─────────────────────────────────────
# Add these lines to your existing .env file.
# They extend (not replace) your current .env.

# Mina Devnet endpoints
# These match DEVNET_ENDPOINTS.DEVNET_PRIMARY in devnet-endpoints.ts exactly.
MINA_GRAPHQL_ENDPOINT=https://api.minascan.io/node/devnet/v1/graphql
MINA_ARCHIVE_ENDPOINT=https://api.minascan.io/archive/devnet/v1/graphql

# --- Set per-run values ---

# The transaction hash to verify.
# Populated automatically by run_and_verify.sh.
# Set manually here if running verifyTransaction.js directly.
TX_HASH=

# The zkApp contract whose on-chain state we read.
# Must match a key in config/environments/testnet.json → deployments.contracts
# Options from your testnet.json:
#   GLEIFOptimMultiCompanySmartContract
#   CorporateRegistrationMultiSmartContract
#   EXIMOptimMultiCompanySmartContract
#   ComposedOptimComplianceVerifierSC
CONTRACT_NAME=GLEIFOptimMultiCompanySmartContract

# The expected value of totalVerificationsGlobal BEFORE the transaction.
# Set to -1 to skip this check entirely.
EXPECTED_BEFORE=-1

# The expected value of totalVerificationsGlobal AFTER the transaction.
# Set to -1 to skip this check entirely.
EXPECTED_AFTER=-1

# Where snapshotState.ts writes the before-snapshot JSON.
# run_and_verify.sh reads from and writes to this same path.
SNAPSHOT_FILE=/tmp/zk_state_before.json

# Retry settings for transient Devnet connectivity issues.
RETRY_COUNT=3
RETRY_DELAY_MS=8000
